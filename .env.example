# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Postgres via Supabase / Neon) ---
DATABASE_URL=postgres://user:password@localhost:5432/mira

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Model routing — see src/lib/ai/client.ts
ANTHROPIC_MODEL_FREE=claude-sonnet-4-6
ANTHROPIC_MODEL_PRO=claude-sonnet-4-6
ANTHROPIC_MODEL_PRO_PLUS=claude-opus-4-7
ANTHROPIC_MODEL_CLASSIFIER=claude-haiku-4-5-20251001
# Set to "1" to send metadata.user_id to Anthropic for abuse monitoring
ANTHROPIC_SEND_USER_METADATA=0

# --- Auth (Better-Auth / Clerk / Supabase) ---
AUTH_SECRET=replace-me-32-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Encryption ---
# 32-byte base64 application key used to envelope per-user keys
APP_ENCRYPTION_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Mira <hello@example.com>"

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_PLUS_MONTHLY=
STRIPE_PRICE_PRO_PLUS_YEARLY=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# --- Monitoring ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
